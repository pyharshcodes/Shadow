# Database connection - SQLite locally, or PostgreSQL in production (e.g., postgresql://user:pass@host:5432/shadow_fitness)
DATABASE_URL="file:./dev.db"

# Authentication secret for JWT/session cookies
AUTH_SECRET="your-secure-random-secret-key-here"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Cloud Storage (defaults to local /uploads if unconfigured)
# CLOUDINARY_URL=
# S3_BUCKET=
